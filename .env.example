# Copy to .env for local development. Never commit real values.
# With neither variable set, the API runs on in-memory stores.

# Supabase Postgres, transaction pooler (port 6543), e.g.
# postgres://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Random secret (≥ 32 chars) used to pseudonymise NHS numbers in the audit log.
# Generate with: openssl rand -hex 32
# Changing it breaks the link between existing audit events and patients.
AUDIT_PSEUDONYM_KEY=
